### Telegram bot API token from BotFather
TELEGRAM_BOT_TOKEN="123456:replace-with-bot-token"

### Your personal Telegram user id. The bot ignores everyone else. Find it from @RawDataBot.
ALLOWED_USER_ID="123456789"

### Local SQLite file path
BOT_DB_PATH="data/car_bot.db"

### MySubaru account credentials
SUBARU_USERNAME="you@example.com"
SUBARU_PASSWORD="replace-with-mysubaru-password"

### Any stable integer. Subaru ties two-factor registration to this value, so
### once src/register_device.py has succeeded, never change it.
SUBARU_DEVICE_ID="1700000000"

### Shown in your MySubaru authorized-devices list
SUBARU_DEVICE_NAME="car-maintenance-bot"

### USA or CAN
SUBARU_COUNTRY="USA"

### Four-digit vehicle PIN. Only needed for remote commands, which this bot
### never sends. Leave blank unless Subaru refuses to connect without it.
SUBARU_PIN=""

### Cron/launchd log output path (used by setup.sh)
BOT_CRON_LOG_PATH="./logs/bot.log"
